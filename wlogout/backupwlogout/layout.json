{
  "layout": [
    "lock",
    "logout",
    "suspend",
    "hibernate",
    "shutdown",
    "reboot"
  ],
  "buttons": {
    "lock": {
      "label": "Lock",
      "action":"sh -c 'sleep 0.5; hyprlock'",
      "icon": "/usr/share/wlogout/icons/lock.png",
      "keybind": "l"
    },
    "logout": {
      "label": "Logout",
      "action": "hyprctl dispatch exit",
      "icon": "/usr/share/wlogout/icons/logout.png",
      "keybind": "e"
    },
    "suspend": {
      "label": "Suspend",
      "action": "systemctl suspend",
      "icon": "/usr/share/wlogout/icons/suspend.png",
      "keybind": "s"
    },
    "hibernate": {
      "label": "Hibernate",
      "action": "systemctl hibernate",
      "icon": "/usr/share/wlogout/icons/hibernate.png",
      "keybind": "h"
    },
    "shutdown": {
      "label": "Shutdown",
      "action": "systemctl poweroff",
      "icon": "/usr/share/wlogout/icons/shutdown.png",
      "keybind": "p"
    },
    "reboot": {
      "label": "Reboot",
      "action": "systemctl reboot",
      "icon": "/usr/share/wlogout/icons/reboot.png",
      "keybind": "r"
    }
  }
}


