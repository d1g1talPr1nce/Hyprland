{
  "layer": "top",
  "position": "top",
  "height": 58,
  "spacing": 3,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "exclusive": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/os",
    "hyprland/workspaces",
    "custom/snake",
    "custom/cava",
    "mpris"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "custom/temperature",
    "network",
    "pulseaudio",
    "tray",
    "custom/clock",
    "custom/dashboard"
  ],
  "custom/os": {
    "format": "󰣇",
    "on-click": "wofi --show drun",
    "tooltip-format": "MIDNIGHT / ICE · Applications"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": false,
    "disable-scroll": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "custom/cava": {
    "exec": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-cava.py\"",
    "format": "{}",
    "tooltip": false,
    "restart-interval": 5
  },
  "mpris": {
    "format": "{status_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "status-icons": {
      "playing": "󰎈",
      "paused": "󰏤",
      "stopped": "󰎊"
    },
    "max-length": 24,
    "tooltip-format": "{player}\n{artist} — {title}"
  },
  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB",
    "on-click": "kitty -e btop"
  },
  "custom/temperature": {
    "exec": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-temperature.py\"",
    "return-type": "json",
    "interval": 5
  },
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀 LAN",
    "format-disconnected": "󰤭 OFF",
    "tooltip-format": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-wifi": "<span size=\"large\" weight=\"bold\" foreground=\"#BCEEFF\">󰤨  NETWORK</span>\n\n{essid}\nSignál  {signalStrength}%\nIP      {ipaddr}\n\n<span foreground=\"#6E8EAE\">Klikni pro správu připojení</span>",
    "on-click": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-network.py\"",
    "on-click-right": "nm-connection-editor",
    "tooltip-format-ethernet": "<span size=\"large\" weight=\"bold\" foreground=\"#BCEEFF\">󰈀  NETWORK</span>\n\n<span foreground=\"#79D8F7\">● Ethernet připojen</span>\n\nRozhraní   {ifname}\nIP adresa  {ipaddr}/{cidr}\nBrána      {gwaddr}\n\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}\n\n<span foreground=\"#6E8EAE\">Klikni pro správu připojení</span>",
    "tooltip-format-disconnected": "<span size=\"large\" foreground=\"#BCEEFF\">󰤭  NETWORK</span>\n\nSíť odpojena\nKlikni pro výběr uloženého připojení"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 MUTE",
    "format-icons": {
      "headphone": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format": "Keep awake: {status}"
  },
  "tray": {
    "icon-size": 19,
    "spacing": 8
  },
  "custom/lock": {
    "format": "󰌾",
    "on-click": "hyprlock",
    "tooltip-format": "Zamknout"
  },
  "custom/power": {
    "format": "",
    "on-click": "wlogout",
    "tooltip-format": "Menu relace"
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 22,
    "separate-outputs": true,
    "icon": true,
    "icon-size": 19,
    "tooltip": true,
    "rewrite": {
      "^.*[Zz]en.*$": "zen",
      "^org\\.mozilla\\.firefox$": "firefox",
      "^org\\.gnome\\.Nautilus$": "files",
      "^org\\.kde\\.dolphin$": "dolphin",
      "^com\\.discordapp\\.Discord$": "discord"
    }
  },
  "custom/snake": {
    "exec": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-snake.py\"",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "escape": false,
    "on-click": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-snake.py\" toggle",
    "on-click-right": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-panel.py\"",
    "on-scroll-up": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-snake.py\" prev",
    "on-scroll-down": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-snake.py\" next"
  },
  "custom/clock": {
    "exec": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-clock.py\"",
    "return-type": "json",
    "interval": 5,
    "on-click": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-panel.py\""
  },
  "custom/dashboard": {
    "format": "󰍜",
    "tooltip-format": "MIDNIGHT CONTROL · otevřít / zavřít",
    "on-click": "python3 \"${MIDNIGHT_WAYBAR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar}/scripts/midnight-panel.py\""
  }
}
