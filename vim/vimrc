" --- AIRLINE KONFIGURACE ---
let g:airline_powerline_fonts = 1
let g:airline_theme = 'gruvbox'
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#formatter = 'unique_tail'
let g:airline#extensions#coc#enabled = 1
let g:airline#extensions#branch#enabled = 1
let g:airline_skip_empty_sections = 1

" Vlastní symboly
if !exists('g:airline_symbols')
  let g:airline_symbols = {}
endif
let g:airline_symbols.branch = ''
let g:airline_symbols.readonly = ''
let g:airline_symbols.linenr = ' '
let g:airline_symbols.maxlinenr = ''
let g:airline_symbols.dirty= '⚡'

" --- NERDTREE KONFIGURACE ---
nnoremap <C-b> :NERDTreeToggle<CR>
nnoremap <leader>nf :NERDTreeFind<CR>

let NERDTreeShowHidden=1
let NERDTreeMinimalUI=1
let NERDTreeIgnore=['\.git$', '\.DS_Store$', '__pycache__', 'node_modules', '\.pyc$']
let NERDTreeDirArrowExpandable = ''
let NERDTreeDirArrowCollapsible = ''

" Automatické zavření když zůstane jen NERDTree
autocmd bufenter * if (winnr("$") == 1 && exists("b:NERDTree") && b:NERDTree.isTabTree()) | q | endif

" --- FZF KONFIGURACE ---
nnoremap <C-p> :Files<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <leader>g :Rg<CR>
nnoremap <leader>h :History<CR>

" --- DALŠÍ PLUGINY ---
" Rainbow závorky
let g:rainbow_active = 1
let g:rainbow_conf = {
\   'guifgs': ['#d65d0e', '#458588', '#b16286', '#689d6a'],
\   'separately': {
\       'nerdtree': 0,
\   }
\}

" IndentLine
let g:indentLine_char = '│'
let g:indentLine_color_gui = '#d5c4a1'
let g:indentLine_fileTypeExclude = ['nerdtree', 'help', 'markdown']

" Illuminate
let g:Illuminate_delay = 250
let g:Illuminate_ftblacklist = ['nerdtree']

" GitGutter
let g:gitgutter_sign_added = '+'
let g:gitgutter_sign_modified = '~'
let g:gitgutter_sign_removed = '-'
set updatetime=100

" --- UŽITEČNÉ MAPOVÁNÍ ---
" Leader key
let mapleader = " "

" Ukládání a zavírání
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>x :wq<CR>

" Split navigace
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Vytvoření splitů
nnoremap <leader>v :vsplit<CR>
nnoremap <leader>s :split<CR>

" Změna velikosti splitů
nnoremap <silent> <A-h> :vertical resize -2<CR>
nnoremap <silent> <A-l> :vertical resize +2<CR>
nnoremap <silent> <A-k> :resize +2<CR>
nnoremap <silent> <A-j> :resize -2<CR>

" Přesunutí řádků (Alt + j/k)
nnoremap <A-j> :m .+1<CR>==
nnoremap <A-k> :m .-2<CR>==
vnoremap <A-j> :m '>+1<CR>gv=gv
vnoremap <A-k> :m '<-2<CR>gv=gv

" Lepší odsazování ve visual mode
vnoremap < <gv
vnoremap > >gv

" Clear search highlight
nnoremap <silent> <Esc><Esc> :noh<CR>

" Rychlé editování vimrc
nnoremap <leader>ev :e $MYVIMRC<CR>
nnoremap <leader>sv :source $MYVIMRC<CR>

" Buffer navigace
nnoremap <leader>bn :bnext<CR>
nnoremap <leader>bp :bprevious<CR>
nnoremap <leader>bd :bdelete<CR>

" --- AUTOMATICKÉ PŘÍKAZY ---
" Odstranění trailing whitespace při uložení
autocmd BufWritePre * :%s/\s\+$//e

" Zapamatování pozice kurzoru
autocmd BufReadPost *
  \ if line("'\"") > 0 && line("'\"") <= line("$") |
  \   exe "normal! g`\"" |
  \ endif

" Automatické zavření popup menu po dokončení
autocmd CompleteDone * if pumvisible() == 0 | pclose | endif

" --- PERFORMANCE ---
set lazyredraw          " Rychlejší scrollování
set ttyfast            " Rychlejší rendering
set synmaxcol=200      " Syntax jen pro prvních 200 znaků

