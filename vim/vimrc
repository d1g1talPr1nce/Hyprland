" ===============================================
" 🎨 MODERNÍ VIM KONFIGURACE PRO ARCH LINUX
" ===============================================

" --- ZÁKLADNÍ NASTAVENÍ ---
syntax on
filetype plugin indent on
set encoding=utf-8
set ts=2 sts=2 sw=2 et ai si
set rnu number                    " Relativní + aktuální číslo řádku
set hls incsearch                 " Zvýraznění hledání + live search
set ignorecase smartcase          " Chytré vyhledávání
set mouse=a                       " Podpora myši
set clipboard=unnamedplus         " Sdílená schránka se systémem (Linux)
set updatetime=300                " Rychlejší refresh pro COC
set signcolumn=yes                " Vždy zobrazit sloupec pro ikony
set splitright splitbelow         " Lepší chování splitů
set scrolloff=8                   " Odsazení při scrollování
set wrap linebreak                " Inteligentní zalamování řádků
set termguicolors                 " 24-bit barvy v terminálu
set hidden                        " Umožní přepínat buffery bez uložení
set nobackup nowritebackup        " COC doporučení
set cmdheight=2                   " Více místa pro zprávy
set shortmess+=c                  " Nevypisovat completion zprávy

" --- PLUGIN MANAGER (vim-plug) ---
" Instalace: curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
"   https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

call plug#begin('~/.vim/plugged')
  " Hlavní pluginy
  Plug 'neoclide/coc.nvim', {'branch': 'release'}
  Plug 'jiangmiao/auto-pairs'
  Plug 'gruvbox-community/gruvbox'
  Plug 'vim-airline/vim-airline'
  Plug 'vim-airline/vim-airline-themes'
  Plug 'preservim/nerdtree'
  Plug 'Yggdroot/indentLine'

  " Vizuální vylepšení
  Plug 'ryanoasis/vim-devicons'
  Plug 'luochen1990/rainbow'
  Plug 'RRethy/vim-illuminate'

  " Další užitečné pluginy
  Plug 'tpope/vim-commentary'       " Komentování (gcc)
  Plug 'tpope/vim-surround'         " Práce se závorkami
  Plug 'airblade/vim-gitgutter'     " Git změny v editoru
  Plug 'Xuyuanp/nerdtree-git-plugin' " Git ikony v NERDTree
  Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
  Plug 'junegunn/fzf.vim'           " Fuzzy finder
call plug#end()

" --- COC KONFIGURACE ---
" Tab pro dokončování
inoremap <silent><expr> <Tab>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <silent><expr> <S-Tab>
      \ coc#pum#visible() ? coc#pum#prev(1) :
      \ "\<C-h>"

function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" Enter pro potvrzení
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

" Ctrl+Space pro trigger completion
inoremap <silent><expr> <c-space> coc#refresh()

" Navigace v kódu
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)

" Diagnostika
nmap <silent> [g <Plug>(coc-diagnostic-prev)
nmap <silent> ]g <Plug>(coc-diagnostic-next)

" Zobrazit dokumentaci
nnoremap <silent> K :call ShowDocumentation()<CR>
function! ShowDocumentation()
  if CocAction('hasProvider', 'hover')
    call CocActionAsync('doHover')
  else
    call feedkeys('K', 'in')
  endif
endfunction

" Automatické zvýraznění
autocmd CursorHold * silent call CocActionAsync('highlight')

" Rename symbol
nmap <leader>rn <Plug>(coc-rename)

" Format selected code
xmap <leader>f  <Plug>(coc-format-selected)
nmap <leader>f  <Plug>(coc-format-selected)

" --- BAREVNÉ SCHÉMA ---
set background=dark
let g:gruvbox_contrast_dark = 'soft'
let g:gruvbox_italic = 1
let g:gruvbox_bold = 1
colorscheme gruvbox

